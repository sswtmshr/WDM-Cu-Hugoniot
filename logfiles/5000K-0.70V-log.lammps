package kokkos
package kokkos newton on neigh half comm device
dimension       3
units           metal
atom_style      atomic
boundary        p p p

# --- Create FCC Cu lattice ---
#lattice         fcc 3.52
#region          box block 0 20 0 20 0 20
#create_box      1 box
#create_atoms    1 box
#mass            1 63.546

read_data       ../../../eos/0.70V/Cu-0.70V.lmp
