LAMMPS (10 Sep 2025)
KOKKOS mode with Kokkos version 4.6.2 is enabled
  using double precision
  using view layout = legacy
  will use up to 1 GPU(s) per node
  using 1 OpenMP thread(s) per MPI task
package kokkos
package kokkos newton on neigh half comm device
dimension       3
units           metal
atom_style      atomic
boundary        p p p

# --- Create FCC Cu lattice ---
#lattice         fcc 3.52
#region          box block 0 20 0 20 0 20
#create_box      1 box
#create_atoms    1 box
#mass            1 63.546

read_data       ../../../eos/1.09V/Cu-1.09V.lmp
Reading data file ...
  orthogonal box = (-1.0257984 -1.0257984 -1.0257984) to (71.425798 71.425798 71.425798)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  32000 atoms
  reading velocities ...
  32000 velocities
  read_data CPU = 0.128 seconds
#change_box     all x scale _scale_ y scale _scale_ z scale _scale_ remap

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

pair_style      eam/alloy
pair_coeff      * * Cu-EAM-Z1622old.eam.alloy Cu

shell           "mkdir -p dumps"

variable	thold equal 300
variable	itemp equal 2*300
variable	runNVE equal 50000
variable	tstep equal 0.0005
variable	ph string 300K-1.09V

timestep        ${tstep}
timestep        0.0005
thermo          200
thermo_style    custom step time temp pe ke pxx pyy pzz press vol density
#thermo_modify	norm yes

dump        	RDUMP all custom 20000 dumps/${ph}-NV-300K-*.xyz id type x y z
dump        	RDUMP all custom 20000 dumps/300K-1.09V-NV-300K-*.xyz id type x y z

#NV  300K calculation
velocity 		all create ${itemp}  23796
velocity 		all create 600  23796

fix 			LANG all langevin ${thold} ${thold} $(300.0*dt) 33948
fix 			LANG all langevin 300 ${thold} $(300.0*dt) 33948
fix 			LANG all langevin 300 300 $(300.0*dt) 33948
fix 			LANG all langevin 300 300 0.14999999999999999445 33948
fix 			NVE all nve
run  			${runNVE}
run  			50000
