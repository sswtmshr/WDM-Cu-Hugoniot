dump        	RDUMP all custom 20000 dumps/${ph}-NV-4000K-*.xyz id type x y z
dump        	RDUMP all custom 20000 dumps/4000K-0.74V-NV-4000K-*.xyz id type x y z

#NV  4000K calculation
velocity 		all create ${itemp}  23796
velocity 		all create 8000  23796

fix 			LANG all langevin ${thold} ${thold} $(300.0*dt) 33948
