dump        	RDUMP all custom 20000 dumps/${ph}-NV-500K-*.xyz id type x y z
dump        	RDUMP all custom 20000 dumps/500K-0.91V-NV-500K-*.xyz id type x y z

#NV  500K calculation
velocity 		all create ${itemp}  23796
velocity 		all create 1000  23796

fix 			LANG all langevin ${thold} ${thold} $(300.0*dt) 33948
