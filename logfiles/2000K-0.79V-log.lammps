  32000 atoms
  reading velocities ...
  32000 velocities
  read_data CPU = 0.128 seconds
#change_box     all x scale _scale_ y scale _scale_ z scale _scale_ remap

neighbor        2.0 bin
neigh_modify    delay 0 every 1 check yes

pair_style      eam/alloy
pair_coeff      * * Cu-EAM-Z1622old.eam.alloy Cu

shell           "mkdir -p dumps"

variable	thold equal 2000
variable	itemp equal 2*2000
variable	runNVE equal 50000
variable	tstep equal 0.0005
variable	ph string 2000K-0.79V

timestep        ${tstep}
timestep        0.0005
thermo          200
thermo_style    custom step time temp pe ke pxx pyy pzz press vol density
#thermo_modify	norm yes

dump        	RDUMP all custom 20000 dumps/${ph}-NV-2000K-*.xyz id type x y z
dump        	RDUMP all custom 20000 dumps/2000K-0.79V-NV-2000K-*.xyz id type x y z

#NV  2000K calculation
velocity 		all create ${itemp}  23796
velocity 		all create 4000  23796

fix 			LANG all langevin ${thold} ${thold} $(300.0*dt) 33948
fix 			LANG all langevin 2000 ${thold} $(300.0*dt) 33948
fix 			LANG all langevin 2000 2000 $(300.0*dt) 33948
fix 			LANG all langevin 2000 2000 0.14999999999999999445 33948
fix 			NVE all nve
run  			${runNVE}
run  			50000
